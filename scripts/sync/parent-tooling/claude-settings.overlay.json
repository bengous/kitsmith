{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bun scripts/validation/guard-parent-tooling-target-edits.ts",
            "timeout": 10,
            "statusMessage": "Checking parent tooling managed targets..."
          }
        ]
      }
    ]
  }
}
